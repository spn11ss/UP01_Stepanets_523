<Page x:Class="UP01_Stepanets.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Stepanets.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Панель администратора">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Панель администратора" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>

            <Button Content="Управление записями" Click="BtnAppointments_Click" Width="300" />

            <Button Content="Управление пользователями" Click="BtnUsers_Click" Width="300" />

            <Button Content="Диаграмма" Click="BtnDiagram_Click" Width="300" />

            <Button Content="Экспорт отчетов" Click="BtnExport_Click" Width="300" />

            <Button Content="Выйти из аккаунта" Click="BtnLogout_Click" Width="300" Background="Transparent"/>

        </StackPanel>
    </Grid>
</Page>
