<Page x:Class="UP01_Stepanets.Pages.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Stepanets.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="450">
        <StackPanel>

            <TextBlock Text="Смена пароля" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Label Content="Ваш логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="TbLogin" ToolTip="Введите ваш логин" Margin="0,0,0,15"/>

            <Label Content="Старый пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PbOldPassword" ToolTip="Введите ваш текущий пароль" Margin="0,0,0,15"/>

            <Label Content="Новый пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PbNewPassword" ToolTip="Минимум 6 символов, только английские буквы и хотя бы одна цифра" Margin="0,0,0,15"/>

            <Label Content="Повторите новый пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PbConfirmPassword" ToolTip="Повторите новый пароль" Margin="0,0,0,20"/>

            <Button Content="Сохранить" Click="BtnSave_Click" Width="250"/>
            <Button Content="Отмена" Click="BtnCancel_Click" Width="250"/>

        </StackPanel>
    </Grid>
</Page>
