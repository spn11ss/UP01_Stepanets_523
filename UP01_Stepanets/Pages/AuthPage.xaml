<Page x:Class="UP01_Stepanets.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Stepanets.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Label Content="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="TextBoxLogin" ToolTip="Введите ваш логин" Margin="0,0,0,15" />

            <Label Content="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" ToolTip="Введите пароль" Margin="0,0,0,15"/>

            <StackPanel x:Name="SpCaptcha" Visibility="Hidden" Margin="0,0,0,15">
                <TextBlock Text="Введите код с картинки:" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <TextBlock x:Name="TbCaptchaText" FontSize="20" FontWeight="Bold" Foreground="#DD4B42" HorizontalAlignment="Center" Margin="0,0,0,10" 
                           TextDecorations="Strikethrough" IsHitTestVisible="False"/>
                <TextBox x:Name="TbCaptchaInput" ToolTip="Введите символы, указанные выше" Margin="0,0,0,5"/>
                <Button Content="Проверить капчу" Click="BtnSubmitCaptcha_Click" Width="200" HorizontalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="BtnEnter" ToolTip="Кнопка входа" Content="Войти" Click="BtnEnter_Click"/>
            <Button x:Name="BtnReg" ToolTip="Кнопка регистрации" Content="Регистрация" Click="BtnReg_Click"/>
            <Button x:Name="BtnChangePass" ToolTip="Кнопка смены пароля" Content="Смена пароля" Click="BtnChangePass_Click" />

        </StackPanel>
    </Grid>
</Page>
